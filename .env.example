# Copia este archivo a .env (no se sube a git)
# Llave gratuita en https://api.nasa.gov
NASA_API_KEY=DEMO_KEY

# Credenciales de la API de Meteomatics (pídelas al equipo; usuario y contraseña de la API, no de la web).
# OPCIONALES: si faltan, o Meteomatics no responde, el clima sale de Open-Meteo (gratis y sin llave).
METEOMATICS_USER=
METEOMATICS_PASSWORD=

# Opcional: DeepL (https://www.deepl.com/pro-api). La pipeline de Cultivos solo la usa para traducir
# al inglés nombres de cultivo nuevos de SIAP que no estén en glosario_en.json. Vacía = no se usa.
DEEPL_API_KEY=

# Token de NASA Earthdata (SRTM, GRACE, SMAP): https://urs.earthdata.nasa.gov -> Generate Token
EARTHDATA_TOKEN=

# Llave de la API de EPPO (https://data.eppo.int/ -> API). La usa el motor de plagas del Planificador, las alertas y
# Noticias. Sin ella esas partes usan reglas generales por tipo de cultivo.
EPPO_API_KEY=
